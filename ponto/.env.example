# Banco do ponto. Em produção, a área "ponto" do Supabase, com o usuário próprio
# dela (só enxerga as tabelas do ponto). Local: o mesmo Postgres de teste do RH
# serve, com ?schema=ponto.
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?schema=ponto&pgbouncer=true"
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres?schema=ponto"

# Segredo para assinar a sessão (gere com: openssl rand -base64 32).
AUTH_SECRET="troque-por-uma-chave-aleatoria-longa"

# Integração com o RH Resultados. A mesma chave vai nos dois sistemas.
RH_URL="https://rhresultados.vercel.app"
INTEGRACAO_SECRET="gere-com-openssl-rand-base64-32"

# Primeiro administrador, criado com "npm run criar-admin".
ADMIN_EMAIL="admin@empresa.com.br"
ADMIN_PASSWORD="senha-forte-aqui"
ADMIN_NAME="Administrador"
