// Sistema de Controle Operacional - Empresa de RH
// Banco: PostgreSQL (local embarcado na 5433, ou Neon / Supabase na nuvem)
//
// Em 2026-09-29 saíram as tabelas dos módulos que já não tinham tela (etapas
// de serviço, escopo contratado, planos e calendários de cultura antigos,
// recrutamento antigo, admissão, anotações, NPS, análise de cargo). O backup
// completo delas está em rhresultados-backup\antes-revisao-geral-2026-09-29.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- Usuários

enum Role {
  ADMIN
  MEMBRO
}

/// Quem usa o sistema pela consultoria. Não confundir com Employee, que é a
/// equipe da empresa cliente.
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           Role     @default(MEMBRO)
  active         Boolean  @default(true)
  /// Sobe a cada troca de senha: os cookies emitidos antes deixam de valer.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companiesCreated Company[]                 @relation("CompanyCreatedBy")
  activities       Activity[]
  meetingsCreated  Meeting[]                 @relation("MeetingCreatedBy")
  recordsCreated   EmployeeRecord[]          @relation("RecordCreatedBy")
  visits           Visit[]                   @relation("VisitConsultant")
  visitsCreated    Visit[]                   @relation("VisitCreatedBy")
  conversasDePdi   ConversaDoPdi[]           @relation("ConversaDoPdiCriadaPor")
  avaliacoesDePdi  AvaliacaoDeCompetencias[] @relation("AvaliacaoCriadaPor")
  examsCreated     HealthExam[]              @relation("ExamCreatedBy")
  expensesCreated  ExpenseEntry[]            @relation("ExpenseCreatedBy")
  scriptsCreated   Script[]                  @relation("ScriptCreatedBy")
}

// ---------------------------------------------------------------- Empresas

enum ContractStatus {
  /// Ainda não é cliente: entrou pela agenda, na reunião de briefing.
  PROSPECTO
  ATIVO
  PAUSADO
  ENCERRADO
}

/// A empresa cliente. Tudo o que é de um cliente pende daqui e cai junto se
/// ela for excluída.
model Company {
  id        String  @id @default(cuid())
  name      String
  legalName String? // razão social
  cnpj      String? @unique

  // Perfil
  industry      String? // ramo / nicho
  tone          String? // tom da empresa
  employeeCount Int?
  website       String?
  description   String?

  // Contato
  contactName  String?
  contactEmail String?
  contactPhone String?

  // Contrato
  contractService String?
  contractValue   Decimal?       @db.Decimal(12, 2)
  contractDate    DateTime?
  contractEndDate DateTime?
  contractStatus  ContractStatus @default(ATIVO)
  paymentDay      Int?

  notes String?

  /// Briefing da primeira reunião, digitado na ficha durante a conversa.
  briefing   String?   @db.Text
  briefingAt DateTime?

  /// Os valores da empresa, um por linha: viram as competências
  /// organizacionais das descrições de cargo.
  valores String? @db.Text

  createdById String?
  createdBy   User?   @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches    Branch[]
  activities  Activity[]
  meetings    Meeting[]
  employees   Employee[]
  visits      Visit[]
  exams       HealthExam[]
  jobOpenings JobOpening[]
  candidates  Candidate[]

  planos           PlanoDeTreinamento[]
  cargos           Cargo[]
  treinamentos     Treinamento[]
  turmas           TurmaDeTreinamento[]
  modeloIntegracao ItemDoModeloDeIntegracao[]
  testesEnviados   TesteEnviado[]
  pesquisasDeClima PesquisaDeClima[]
  perguntasDeClima PerguntaDeClima[]

  @@index([name])
}

model Branch {
  id             String  @id @default(cuid())
  companyId      String
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  isHeadquarters Boolean @default(false)

  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  zipCode    String?

  employeeCount Int?
  phone         String?

  employees Employee[]

  createdAt        DateTime          @default(now())
  encontrosDePlano EncontroDoPlano[]

  @@index([companyId])
}

// --------------------------------------------------- Fluxo de atividades

model Activity {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      String // CRIOU, CONCLUIU, ATUALIZOU...
  entityType  String // REUNIAO, PLANO, AGENDA, COLABORADOR, PONTO, SELECAO, EMPRESA...
  entityId    String?
  description String

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

// ------------------------------------------------------ Catálogo de produtos

/// O catálogo de produtos da consultoria: o que ela oferece. É a lista que o
/// plano de treinamento, a reunião e a agenda oferecem para escolher.
model Service {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// O que fazemos pela empresa, em poucas linhas.
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planos   PlanoDeTreinamento[]
  reunioes Meeting[]
  visitas  Visit[]
}

// ---------------------------------------------------- Proteção de acesso

/// Cada tentativa de login, para travar ataque de força bruta.
/// Fica no banco (e não em memória) para valer também quando a aplicação
/// roda em várias instâncias, como na Vercel.
model LoginAttempt {
  id      String  @id @default(cuid())
  email   String
  ip      String?
  success Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ------------------------------------------------------------ Configuração

/// Configuração da instalação. Linha única, identificada por id = "app".
/// Guarda a identidade de quem presta o serviço, usada no relatório entregue
/// ao cliente.
model Settings {
  id String @id @default("app")

  orgName      String  @default("RH Resultados")
  orgDocument  String?
  orgContact   String?
  /// Texto do rodapé do relatório.
  reportFooter String?

  updatedAt DateTime @updatedAt
}

// --------------------------------------------------------------- Reuniões

/// Reunião com o cliente: pauta escrita antes, ata escrita depois
/// (conversado, decidido, combinado), participantes e apresentação usada.
model Meeting {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// O número da reunião na empresa, que aparece como REU-0001.
  number Int @default(0)

  title      String
  /// Dia da reunião, em UTC 00:00 como a agenda. Vazio enquanto está "a agendar".
  date       DateTime?
  /// Hora no formato "HH:MM", como na agenda.
  startTime  String?
  /// PLANEJADA (em preparação no plano), AGENDADA, REALIZADA (encerrada) ou ARQUIVADA.
  status     String    @default("AGENDADA")
  /// O setor da equipe a que a reunião diz respeito.
  department String?
  /// A unidade da empresa. Vazio é a rede toda. Só o id: a unidade apagada
  /// deixa a reunião na rede, sem apagar a reunião.
  branchId   String?
  /// Tipo livre: equipe, gestores, dentistas…
  kind       String?
  location   String?
  /// A pauta: o que vai ser conversado, escrita antes e completada durante a semana.
  agenda     String?   @db.Text
  /// O compromisso que a reunião tem na agenda, enquanto tem data.
  visitId    String?   @unique

  /// O produto do catálogo a que a reunião se refere — qualquer um, contratado
  /// ou não. Na reunião de plano, vazio quer dizer o produto do plano.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  /// O plano de treinamento a que a reunião pertence, e a posição dela nele.
  planoId      String?
  plano        PlanoDeTreinamento? @relation(fields: [planoId], references: [id], onDelete: SetNull)
  ordemNoPlano Int?

  createdById String?
  createdBy   User?   @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  encontroDoPlano EncontroDoPlano?
  /// Quando a reunião é uma turma de treinamento: o que é próprio dela.
  turma           TurmaDeTreinamento?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A ata: o conversado, o decidido e o combinado.
  items        MeetingItem[]
  participants MeetingParticipant[]
  /// As apresentações usadas na reunião.
  files        MeetingFile[]

  @@index([companyId, date])
  @@index([planoId])
  @@index([serviceId])
}

/// Um arquivo da reunião: a apresentação usada nela, como veio.
///
/// Fica no banco porque o sistema publicado não tem disco próprio. Mais de um
/// por reunião: às vezes a apresentação vem em partes.
model MeetingFile {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  name     String
  mimeType String
  size     Int
  data     Bytes

  createdAt DateTime @default(now())

  @@index([meetingId])
}

/// Um item da ata: o que foi conversado, decidido ou combinado.
///
/// Cada tipo pede uma coisa: o conversado é contexto, sem responsável nem
/// prazo; o decidido vale desde uma data e tem um porquê; o combinado tem um
/// responsável e uma data — e é cobrado por ela.
model MeetingItem {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// CONVERSADO, DECIDIDO ou COMBINADO.
  kind String
  text String @db.Text

  /// No decidido: por quê.
  reason    String?   @db.Text
  /// No decidido: vale desde quando.
  validFrom DateTime?

  /// No combinado: quem faz.
  responsible String?
  /// No combinado: a data combinada da entrega, em UTC 00:00.
  dueDate     DateTime?
  done        Boolean   @default(false)
  doneAt      DateTime?

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingId])
  @@index([kind, done, dueDate])
}

/// Quem foi convocado para a reunião.
model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// O colaborador da empresa, quando veio da equipe. Só o id, com o nome
  /// guardado ao lado: quem sai da equipe continua na ata de quando estava.
  employeeId String?
  name       String
  /// Convocado é quem foi chamado; presente é marcado depois, por quem conduziu.
  present    Boolean @default(false)

  @@index([meetingId])
}

// ------------------------------------------------- Equipe da empresa cliente

enum EmployeeStatus {
  ATIVO
  AFASTADO
  DESLIGADO
}

/// Colaborador da empresa cliente — não confundir com User, que é quem
/// acessa este sistema pela consultoria de RH.
model Employee {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Unidade onde trabalha, quando a empresa tem mais de uma.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name       String
  document   String?
  /// O nome do cargo, sempre igual ao cargo escolhido da lista da empresa.
  /// Fica aqui também porque exames e telas antigas leem o texto.
  role       String?
  cargoId    String?
  cargo      Cargo?  @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  department String?
  email      String?
  phone      String?

  birthDate    DateTime?
  hiredAt      DateTime?
  terminatedAt DateTime?

  status EmployeeStatus @default(ATIVO)
  /// Observações gerais e permanentes sobre a pessoa.
  notes  String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records     EmployeeRecord[]
  integracao  EtapaDeIntegracao[]
  plans       DevelopmentPlan[]
  assessments SkillAssessment[]
  avaliacoes  AvaliacaoDeCompetencias[]
  exams       HealthExam[]

  @@index([companyId, name])
  @@index([branchId])
  @@index([cargoId])
}

enum RecordKind {
  OBSERVACAO
  ADVERTENCIA
  FALTA
  ATESTADO
}

enum WarningSeverity {
  VERBAL
  ESCRITA
  SUSPENSAO
}

/// Linha do tempo do colaborador: observações, advertências, faltas e
/// atestados num registro só, para serem lidos em ordem cronológica.
///
/// Atestado é dado de saúde: aqui guardamos apenas período e afastamento.
/// Não existe campo de diagnóstico ou CID de propósito — é dado sensível e o
/// acompanhamento de RH não precisa dele.
model EmployeeRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  kind        RecordKind
  date        DateTime
  /// Fim do período, em atestado ou suspensão de vários dias.
  endDate     DateTime?
  description String     @db.Text

  /// Só em ADVERTENCIA.
  severity  WarningSeverity?
  /// Só em FALTA: se foi abonada.
  justified Boolean?

  createdById String?
  createdBy   User?   @relation("RecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([employeeId, date])
}

enum PlanStatus {
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

/// Plano de Desenvolvimento Individual.
///
/// O caminho: a descrição do cargo diz as competências esperadas; a avaliação
/// feita junto com a pessoa mostra os gaps; cada gap que se decide trabalhar
/// vira uma meta SMART, com as ações para chegar lá; e as conversas de
/// acompanhamento registram o avanço de cada meta até o plano fechar.
model DevelopmentPlan {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title     String
  objective String?    @db.Text
  startDate DateTime?
  endDate   DateTime?
  status    PlanStatus @default(EM_ANDAMENTO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Autoavaliação antiga (texto livre) que originou o plano, quando veio de uma.
  assessmentId String?          @unique
  assessment   SkillAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  /// A avaliação de competências de onde saíram as metas.
  avaliacaoId String?
  avaliacao   AvaliacaoDeCompetencias? @relation(fields: [avaliacaoId], references: [id], onDelete: SetNull)

  /// A próxima conversa de acompanhamento, que também está na agenda.
  proximaConversa DateTime?
  visitId         String?   @unique
  visit           Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)

  /// Como terminou: o balanço escrito ao encerrar o plano.
  balanco String? @db.Text

  actions   DevelopmentAction[]
  metas     MetaDoPdi[]
  conversas ConversaDoPdi[]

  @@index([employeeId])
  @@index([avaliacaoId])
}

/// Uma meta SMART do PDI: específica (titulo), mensurável (indicador),
/// atingível (recursos), relevante (relevancia) e temporal (prazo).
model MetaDoPdi {
  id     String          @id @default(cuid())
  planId String
  plan   DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// O gap que a meta trabalha, quando veio da avaliação.
  notaId      String?
  nota        NotaDeCompetencia? @relation(fields: [notaId], references: [id], onDelete: SetNull)
  /// O nome da competência, guardado para não depender da avaliação.
  competencia String?

  titulo     String
  indicador  String?   @db.Text
  recursos   String?   @db.Text
  relevancia String?   @db.Text
  prazo      DateTime?

  /// NAO_INICIADA, EM_ANDAMENTO, ATINGIDA, NAO_ATINGIDA ou CANCELADA.
  status    String @default("NAO_INICIADA")
  /// 0 a 100, atualizado nas conversas de acompanhamento.
  progresso Int    @default(0)
  ordem     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acoes      DevelopmentAction[]
  progressos ProgressoDaMeta[]

  @@index([planId])
  @@index([notaId])
}

/// Ação do PDI, marcada conforme é cumprida.
model DevelopmentAction {
  id     String          @id @default(cuid())
  planId String
  plan   DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// A meta que a ação serve. Vazio nas ações dos planos antigos, sem metas.
  metaId String?
  meta   MetaDoPdi? @relation(fields: [metaId], references: [id], onDelete: Cascade)

  /// PRATICA (no dia a dia), TROCA (mentoria, feedback, acompanhar alguém)
  /// ou FORMAL (curso, leitura, treinamento) — o 70-20-10.
  tipo          String       @default("PRATICA")
  /// Quem garante que acontece: a pessoa, o líder, o RH.
  responsavel   String?
  /// Treinamento do catálogo: presente numa turma realizada, a ação se cumpre.
  treinamentoId String?
  treinamento   Treinamento? @relation(fields: [treinamentoId], references: [id], onDelete: SetNull)

  title       String
  description String?   @db.Text
  order       Int       @default(0)
  /// Feita por inteiro (quantoFeito = 100). Fica para quem só lê feito/não feito.
  done        Boolean   @default(false)
  /// Como um combinado, mas medido: 0, 25, 50, 75 ou 100%.
  quantoFeito Int       @default(0)
  /// Como foi: o que se fez, o que faltou.
  observacao  String?   @db.Text
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([planId])
  @@index([metaId])
  @@index([done, dueDate])
  @@index([treinamentoId])
}

/// Uma conversa de acompanhamento do PDI: o que foi conversado, o que ficou
/// combinado e onde cada meta estava naquele dia.
model ConversaDoPdi {
  id     String          @id @default(cuid())
  planId String
  plan   DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  data       DateTime
  resumo     String   @db.Text
  combinados String?  @db.Text

  createdById String?
  createdBy   User?    @relation("ConversaDoPdiCriadaPor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  progressos ProgressoDaMeta[]

  @@index([planId, data])
}

/// Onde a meta estava numa conversa: é a linha do tempo do avanço.
model ProgressoDaMeta {
  id         String        @id @default(cuid())
  conversaId String
  conversa   ConversaDoPdi @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  metaId     String
  meta       MetaDoPdi     @relation(fields: [metaId], references: [id], onDelete: Cascade)

  progresso  Int
  status     String
  comentario String? @db.Text

  @@index([metaId])
  @@index([conversaId])
}

/// Uma competência da descrição de cargo, com o nível que o cargo pede.
model CompetenciaDoCargo {
  id      String @id @default(cuid())
  cargoId String
  cargo   Cargo  @relation(fields: [cargoId], references: [id], onDelete: Cascade)

  nome          String
  /// TECNICA ou COMPORTAMENTAL.
  tipo          String  @default("TECNICA")
  /// O que se espera ver no dia a dia de quem domina a competência.
  descricao     String? @db.Text
  /// 1 a 5.
  nivelEsperado Int     @default(3)
  ordem         Int     @default(0)

  notas NotaDeCompetencia[]

  @@index([cargoId])
}

/// A avaliação de competências feita junto com a pessoa: o diagnóstico do PDI.
/// Repetida mais tarde, mostra o quanto cada gap fechou.
model AvaliacaoDeCompetencias {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// O cargo da pessoa no dia, e o nome dele, para a avaliação não mudar se o
  /// cargo mudar depois.
  cargoId    String?
  cargo      Cargo?   @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  cargoNome  String?

  data DateTime

  /// A parte aberta da conversa.
  pontosFortes    String? @db.Text
  querDesenvolver String? @db.Text
  apoio           String? @db.Text
  carreira        String? @db.Text

  createdById String?
  createdBy   User?    @relation("AvaliacaoCriadaPor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notas  NotaDeCompetencia[]
  planos DevelopmentPlan[]

  @@index([employeeId, data])
  @@index([cargoId])
}

/// A nota de uma competência numa avaliação: como a pessoa se vê, como o
/// avaliador vê, e o nível em que os dois concordaram. O gap é o esperado
/// menos o acordado.
model NotaDeCompetencia {
  id            String                  @id @default(cuid())
  avaliacaoId   String
  avaliacao     AvaliacaoDeCompetencias @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  competenciaId String?
  competencia   CompetenciaDoCargo?     @relation(fields: [competenciaId], references: [id], onDelete: SetNull)

  /// Copiados da competência no dia da avaliação.
  nome     String
  tipo     String @default("TECNICA")
  esperado Int

  pessoa     Int?
  avaliador  Int?
  acordado   Int?
  comentario String? @db.Text
  ordem      Int     @default(0)

  metas MetaDoPdi[]

  @@index([avaliacaoId])
  @@index([competenciaId])
}

/// Autoavaliação técnica respondida pelo colaborador. É a base do plano de
/// desenvolvimento técnico (um PDI), montado à mão ou com a ajuda da IA.
model SkillAssessment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  roleTasks       String? @db.Text
  strengths       String? @db.Text
  difficulties    String? @db.Text
  toolsAndSystems String? @db.Text
  blockers        String? @db.Text
  wantsToDevelop  String? @db.Text
  supportNeeded   String? @db.Text
  other           String? @db.Text

  createdAt DateTime @default(now())

  plan DevelopmentPlan?

  @@index([employeeId])
}

// ------------------------------------------------------------------ Agenda

enum VisitKind {
  /// Primeira reunião: briefing e fechamento.
  BRIEFING
  ACOMPANHAMENTO
  ENTREGA
  OUTRO
}

/// Reunião é conversa com gente (pauta, ata); tarefa é trabalho a fazer
/// naquele horário.
enum VisitNatureza {
  REUNIAO
  TAREFA
}

enum VisitStatus {
  AGENDADA
  REALIZADA
  CANCELADA
}

/// Um compromisso na empresa cliente: o dia, a hora e o produto trabalhado.
///
/// Pode nascer à mão, de uma reunião (Meeting.visitId) ou de um encontro do
/// plano de treinamento ("Mandar para a agenda"). Quando tem reunião ligada,
/// dia, hora, local e situação andam juntos.
model Visit {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// O produto do catálogo trabalhado no dia. Opcional: nem todo compromisso
  /// é de um produto só.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  /// Dia da visita, sempre em UTC 00:00 — como o resto do sistema.
  date      DateTime
  /// Hora no formato "HH:MM". Texto, e não DateTime, para não arrastar fuso:
  /// 09:00 na empresa é 09:00 em qualquer servidor.
  startTime String
  endTime   String?

  /// Assunto, quando não é o nome do produto que descreve o dia.
  subject  String?
  /// Onde: filial, endereço ou "online".
  location String?
  notes    String? @db.Text

  kind     VisitKind     @default(ACOMPANHAMENTO)
  natureza VisitNatureza @default(REUNIAO)
  status   VisitStatus   @default(AGENDADA)

  /// Série de repetição: todas as ocorrências compartilham este id.
  ///
  /// As ocorrências são criadas de uma vez, e não calculadas na hora de
  /// mostrar. Assim cada uma pode ser remarcada ou cancelada sozinha, que é
  /// o que acontece na prática com reunião de cliente.
  seriesId   String?
  frequencia String?

  /// Quem da consultoria vai.
  consultantId String?
  consultant   User?   @relation("VisitConsultant", fields: [consultantId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("VisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// O encontro do plano de treinamento que gerou este compromisso.
  encontroDoPlano EncontroDoPlano?
  /// O PDI cuja próxima conversa é este compromisso.
  pdi             DevelopmentPlan?
  /// A pauta: os assuntos combinados para este compromisso.
  topics          VisitTopic[]

  @@index([date])
  @@index([companyId, date])
  @@index([seriesId])
  @@index([consultantId])
  @@index([serviceId])
}

/// Assunto da pauta de um compromisso.
model VisitTopic {
  id      String @id @default(cuid())
  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  title String
  order Int     @default(0)
  done  Boolean @default(false)

  @@index([visitId])
}

// -------------------------------------------------- Exames ocupacionais

enum ExamKind {
  ADMISSIONAL
  PERIODICO
  RETORNO_AO_TRABALHO
  MUDANCA_DE_FUNCAO
  DEMISSIONAL
}

enum ExamStatus {
  A_AGENDAR
  AGENDADO
  REALIZADO
  CANCELADO
}

enum ExamResult {
  APTO
  APTO_COM_RESTRICAO
  INAPTO
}

/// Exame ocupacional a agendar, agendado ou já realizado.
///
/// O admissional é o caso comum de exame sem ficha de colaborador: o exame
/// vem antes da contratação. Por isso `employeeId` é opcional e existe
/// `candidateName` para o período em que a pessoa ainda é candidata.
model HealthExam {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  /// Nome de quem vai fazer o exame enquanto não há ficha de colaborador.
  candidateName String?
  /// Cargo para o qual a pessoa está sendo avaliada.
  jobTitle      String?

  kind   ExamKind   @default(ADMISSIONAL)
  status ExamStatus @default(A_AGENDAR)

  /// Até quando o exame precisa acontecer. No admissional, é o dia anterior
  /// ao início do trabalho: a lei não admite começar sem o exame.
  dueDate DateTime?

  /// Dia marcado, em UTC 00:00, e a hora como texto — mesma escolha da agenda.
  scheduledAt   DateTime?
  scheduledTime String?

  clinic      String?
  clinicPhone String?

  performedAt  DateTime?
  result       ExamResult?
  /// Restrições descritas no ASO, quando o resultado é apto com restrição.
  restrictions String?     @db.Text
  /// Até quando o ASO vale — é o que dispara o próximo periódico.
  validUntil   DateTime?

  notes String? @db.Text

  createdById String?
  createdBy   User?   @relation("ExamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
  @@index([dueDate])
}

// ------------------------------------------------- Gestão da consultoria

/// Linha do plano de contas de despesa da consultoria.
///
/// É editável de propósito: cada consultoria organiza o gasto do seu jeito, e
/// mudar a linha depois de meses de histórico dá retrabalho. Por isso a linha
/// é arquivada, e não apagada, quando já tem lançamento.
model ExpenseLine {
  id     String  @id @default(cuid())
  name   String
  /// Agrupamento na tabela: PESSOAS, ENTREGA, ESTRUTURA, IMPOSTOS, FUNDOS.
  group  String?
  order  Int     @default(0)
  active Boolean @default(true)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries ExpenseEntry[]

  @@index([order])
}

/// Quanto foi pago numa linha, num mês.
///
/// Um lançamento por linha e por mês: o painel é de fechamento mensal, não de
/// contas a pagar. O mês é gravado sempre no dia 1 em UTC, como o resto do
/// sistema faz com data.
model ExpenseEntry {
  id     String      @id @default(cuid())
  lineId String
  line   ExpenseLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  month  DateTime
  amount Decimal  @db.Decimal(12, 2)
  notes  String?

  createdById String?
  createdBy   User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lineId, month])
  @@index([month])
}

// ------------------------------------------------------------- Roteiros

enum ScriptStatus {
  RASCUNHO
  APROVADO
  GRAVADO
  PUBLICADO
  DESCARTADO
}

enum ScriptFramework {
  PASTOR
  HVC
}

/// Roteiro de vídeo curto, escrito no método de Ray Edwards.
///
/// Pode ser escrito à mão ou gerado pela IA. Guarda o que foi entregue e o
/// que ficou depois da edição — cada bloco mudado vira um exemplo em
/// `ScriptEdit`.
model Script {
  id String @id @default(cuid())

  // Os INPUTS do método.
  tema            String
  publico         String
  objetivo        String
  plataforma      String?
  duracaoSegundos Int     @default(30)
  tom             String?
  oferta          String?
  provaSocial     String?
  objecoes        String?
  cta             String?
  restricoes      String?

  /// Por qual lado este roteiro ataca o tema.
  angulo     String?
  framework  ScriptFramework
  copyThesis String          @db.Text
  dsi        String          @db.Text

  /// Blocos como estão hoje: [{ rotulo, texto }].
  blocos              Json
  /// Blocos como nasceram, para comparar com o editado.
  blocosOriginais     Json
  /// Ganchos alternativos para teste.
  ganchosAlternativos Json

  status           ScriptStatus @default(RASCUNHO)
  /// Por que foi descartado — alimenta o aprendizado tanto quanto a edição.
  descartadoPorque String?

  createdById String?
  createdBy   User?   @relation("ScriptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edits ScriptEdit[]

  @@index([status, createdAt])
}

/// Uma correção feita à mão num bloco do roteiro.
///
/// É o material de aprendizado: as edições recentes entram no pedido à IA
/// como exemplo de como esta pessoa escreve. Pode ser desligada, para um
/// exemplo ruim não contaminar as próximas gerações.
model ScriptEdit {
  id       String @id @default(cuid())
  scriptId String
  script   Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  bloco  String
  antes  String @db.Text
  depois String @db.Text

  /// Falso quando a pessoa manda o sistema esquecer este exemplo.
  usarComoExemplo Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([scriptId])
  @@index([usarComoExemplo, createdAt])
}

// ------------------------------------------------------- Processo seletivo

enum JobOpeningStatus {
  ABERTA
  PAUSADA
  ENCERRADA
}

/// O que a etapa cobra do candidato. O tipo não muda o nome que ela escreve:
/// serve para o sistema saber o que cobrar e o que mostrar como pendência.
enum EtapaTipo {
  /// Leitura do currículo pela consultoria, sem nada a cobrar do candidato.
  TRIAGEM
  /// Ficha de solicitação de emprego.
  FICHA
  /// Um ou mais testes enviados por link (aba Testes).
  TESTE
  /// Conversa marcada.
  ENTREVISTA
  /// Qualquer etapa da consultoria: dinâmica, visita, prova prática.
  LIVRE
  /// A decisão final: aprovar, reprovar ou encaminhar ao cliente.
  DECISAO
}

/// O que aconteceu com o candidato em uma etapa.
enum MovimentoResultado {
  /// Chegou na etapa.
  ENTROU
  /// Passou para a próxima.
  APROVADO
  /// Parou aqui.
  REPROVADO
  /// Saiu por conta própria.
  DESISTIU
}

enum CandidateOutcome {
  EM_ANDAMENTO
  APROVADO
  REPROVADO
  DESISTIU
}

/// Uma vaga aberta de um cliente, com as etapas e os candidatos dela. A mesma
/// vaga aberta de novo é uma vaga nova, com os seus candidatos.
model JobOpening {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// O cargo, como aparece no anúncio: "Recepcionista".
  title   String
  /// O cargo da lista da empresa, quando a vaga é para um deles: de lá vêm as
  /// perguntas da entrevista na abertura.
  cargoId String?
  cargo   Cargo?           @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  status  JobOpeningStatus @default(ABERTA)
  notes   String?          @db.Text

  openedAt DateTime  @default(now())
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// O roteiro da entrevista desta vaga: ["Pergunta 1", "Pergunta 2"].
  /// Editar depois não muda as entrevistas já organizadas, que guardam cópia.
  perguntasDaEntrevista Json?

  /// As etapas desta vaga, copiadas do modelo escolhido e editáveis aqui:
  /// mexer no modelo depois não mexe nas vagas já abertas.
  etapas     EtapaDaVaga[]
  candidates Candidate[]

  @@index([companyId, status])
  @@index([cargoId])
}

/// Um modelo de processo seletivo: a lista de etapas que ela costuma usar.
///
/// É dela, não da empresa: o mesmo modelo serve a vários clientes. Ao abrir
/// uma vaga as etapas são copiadas para lá, e dali em diante andam sozinhas.
model ProcessoModelo {
  id        String  @id @default(cuid())
  nome      String
  descricao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etapas EtapaDoModelo[]
}

model EtapaDoModelo {
  id       String         @id @default(cuid())
  modeloId String
  modelo   ProcessoModelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  nome      String
  ordem     Int
  tipo      EtapaTipo @default(LIVRE)
  /// Quantos dias o candidato pode ficar aqui antes de virar pendência.
  prazoDias Int?

  @@index([modeloId])
}

/// Uma etapa da vaga: a coluna onde os candidatos ficam.
model EtapaDaVaga {
  id     String     @id @default(cuid())
  vagaId String
  vaga   JobOpening @relation(fields: [vagaId], references: [id], onDelete: Cascade)

  nome      String
  ordem     Int
  tipo      EtapaTipo @default(LIVRE)
  prazoDias Int?

  candidatos Candidate[]

  @@index([vagaId])
}

/// Cada passo do candidato pelo processo, com o motivo.
///
/// É o histórico da ficha e, somado, o funil da vaga: quantos chegaram em cada
/// etapa, quantos passaram e por que os outros pararam.
model MovimentoDoCandidato {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  /// O nome da etapa no dia do movimento: renomear a etapa não reescreve o
  /// histórico.
  etapaNome String
  etapaId   String?

  resultado MovimentoResultado
  motivo    String?            @db.Text

  criadoEm    DateTime @default(now())
  criadoPorId String?

  @@index([candidateId, criadoEm])
}

/// Um candidato de uma vaga, da chegada à decisão.
model Candidate {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobOpeningId String?
  jobOpening   JobOpening? @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)

  name  String
  email String?
  phone String?

  /// Por onde chegou: EMAIL ou MANUAL.
  source String @default("MANUAL")

  /// Em que etapa da vaga ele está. Vazio: a vaga ainda não tem etapas.
  etapaId    String?
  etapa      EtapaDaVaga? @relation(fields: [etapaId], references: [id], onDelete: SetNull)
  /// Desde quando está nesta etapa — é daqui que sai o "parado há X dias".
  etapaDesde DateTime     @default(now())

  outcome    CandidateOutcome @default(EM_ANDAMENTO)
  /// A observação de cada etapa: { "<id da etapa>": "..." }.
  stageNotes Json?
  /// Observações finais da ficha do candidato.
  finalNotes String?          @db.Text

  /// Quando ela cobrou pela última vez a ficha ou o teste que não voltou.
  cobradoEm DateTime?
  /// Quando o candidato foi avisado do resultado. Sem isso, ninguém sabe se o
  /// retorno foi dado — e é o que mais some no meio do processo.
  avisadoEm DateTime?

  /// O texto do currículo, quando vier de um arquivo ou da caixa de e-mail.
  resumeText String? @db.Text

  /// O e-mail de origem, para quando a caixa do recrutamento for ligada. O
  /// Message-ID impede o mesmo e-mail de virar dois candidatos.
  emailMessageId String?   @unique
  emailFrom      String?
  emailTo        String?
  emailSubject   String?
  receivedAt     DateTime?

  /// A ficha de solicitação de emprego, respondida pelo link.
  applicationToken      String    @unique
  applicationAnswers    Json?
  applicationSentAt     DateTime?
  applicationAnsweredAt DateTime?

  /// A entrevista: a transcrição colada, as respostas organizadas pelas
  /// perguntas da vaga (cópia delas) e a avaliação de quem entrevistou.
  entrevista   Json?
  /// Quando a entrevista foi registrada, para o quadro mostrar sem ler o JSON.
  entrevistaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movimentos MovimentoDoCandidato[]
  /// Os testes mandados a ele pela aba Testes, direto do quadro da vaga.
  testes     TesteEnviado[]

  @@index([companyId, jobOpeningId])
  @@index([jobOpeningId, etapaId])
  @@index([etapaId])
}

// ------------------------------------------------------ Testes cadastrados

/// Um teste cadastrado pela consultoria, que vale para qualquer empresa.
///
/// A estrutura é dela: as questões, as alternativas com a chave de cada uma
/// (o fator que a alternativa soma), os fatores e os pares que formam o tipo.
/// Quem responde recebe uma cópia no envio, para editar o teste depois não
/// mudar o que foi respondido.
model CustomTest {
  id String @id @default(cuid())

  name         String
  /// O que a pessoa lê antes de começar.
  instructions String? @db.Text
  /// ESCOLHA (uma alternativa por questão) ou NOTAS (ordenar as alternativas).
  mode         String  @default("ESCOLHA")
  /// [{ codigo, nome, descricao }]
  factors      Json
  /// [["E", "I"], ["S", "N"]]: cada par dá uma letra do tipo.
  pairs        Json?
  /// [{ enunciado, opcoes: [{ texto, fator }] }]
  questions    Json
  active       Boolean @default(true)

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testeEnviados TesteEnviado[]
}

// ------------------------------------------------------ plano de treinamento

/// O plano de treinamento de uma empresa, sempre dentro de um produto do
/// catálogo: o objetivo, a periodicidade e os encontros que cumprem o plano.
model PlanoDeTreinamento {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  titulo        String
  objetivo      String   @db.Text
  /// SEMANAL, QUINZENAL, MENSAL ou LIVRE (sem data fixa).
  periodicidade String   @default("MENSAL")
  /// A hora de costume das reuniões, "14:00".
  horario       String?
  inicio        DateTime
  /// ATIVO, PAUSADO ou CONCLUIDO.
  status        String   @default("ATIVO")

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reunioes  Meeting[]
  encontros EncontroDoPlano[]

  @@index([companyId])
  @@index([serviceId])
}

// ------------------------------------------------------------------- testes

/// Um teste mandado por link para alguém responder: candidato, colaborador ou
/// qualquer pessoa. O link é a credencial e aceita uma resposta só.
model TesteEnviado {
  id    String @id @default(cuid())
  token String @unique

  /// DISC (o da consultoria) ou CADASTRADO (um CustomTest).
  tipo         String
  customTestId String?
  customTest   CustomTest? @relation(fields: [customTestId], references: [id], onDelete: SetNull)
  /// Cópia do teste cadastrado no dia do envio: editar o teste depois não muda o que foi respondido.
  estrutura    Json?
  nomeDoTeste  String

  pessoa    String
  telefone  String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  /// O candidato de uma vaga, quando o teste foi mandado pelo quadro da Seleção.
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  /// ENVIADO ou RESPONDIDO.
  status    String @default("ENVIADO")
  respostas Json?
  resultado Json?

  enviadoPor   String?
  enviadoEm    DateTime  @default(now())
  respondidoEm DateTime?

  @@index([enviadoEm])
  @@index([candidateId])
  @@index([companyId])
  @@index([customTestId])
}

/// Um encontro do plano de treinamento, numa filial (ou na empresa toda).
///
/// O plano só planeja: o encontro vai para a agenda quando se aperta
/// "Mandar para a agenda", e vira reunião (pauta e ata) quando, na agenda, se
/// aperta "Mandar para reunião". Assim a aba Reuniões só tem o que vai
/// acontecer de fato.
model EncontroDoPlano {
  id       String             @id @default(cuid())
  planoId  String
  plano    PlanoDeTreinamento @relation(fields: [planoId], references: [id], onDelete: Cascade)
  /// A filial onde acontece. Vazio: a empresa toda (ou a que não tem filial).
  branchId String?
  branch   Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)

  ordem Int
  tema  String
  /// O dia planejado (UTC 00:00) e a hora. Sem dia: a agendar.
  data  DateTime?
  hora  String?
  /// A pauta, escrita já no planejamento. Quando o encontro vira reunião,
  /// vai para a pauta dela (e dali em diante as duas andam juntas).
  pauta String?   @db.Text

  visitId   String?  @unique
  visit     Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  meetingId String?  @unique
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planoId])
  @@index([branchId])
}

// ------------------------------------------- treinamento e desenvolvimento

/// Um cargo da empresa cliente. A lista é da empresa: o colaborador escolhe
/// dela, e a matriz de treinamento diz o que cada cargo precisa fazer.
model Cargo {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nome      String

  createdAt DateTime @default(now())

  /// A descrição do cargo: para que ele existe, o que faz e o que exige.
  missao            String? @db.Text
  /// Uma por linha.
  responsabilidades String? @db.Text
  /// Formação, experiência e conhecimentos.
  requisitos        String? @db.Text

  /// GERENCIAL, TECNICO ou OPERACIONAL: decide a versão do questionário de
  /// cargo. Vazio nos cargos criados antes da aba Cargos, até ela escolher.
  nivel                 String?
  setor                 String?
  cbo                   String?
  /// O cargo do superior imediato, como texto: pode ser de fora da lista.
  superior              String?
  subordinados          String?
  /// As condições do cargo (autonomia, riscos, esforço...), um texto por
  /// chave. As chaves e os rótulos estão em src/lib/cargos.ts.
  especificacao         Json?
  /// O roteiro de entrevista para contratar o cargo: array de strings, no
  /// mesmo formato de JobOpening.perguntasDaEntrevista, que copia daqui.
  perguntasDaEntrevista Json?
  /// A última vez que a descrição foi aprovada: vale como data de revisão.
  aprovadaEm            DateTime?

  colaboradores Employee[]
  questionarios QuestionarioDeCargo[]
  vagas         JobOpening[]
  treinamentos  TreinamentoDoCargo[]
  competencias  CompetenciaDoCargo[]
  avaliacoes    AvaliacaoDeCompetencias[]

  @@unique([companyId, nome])
}

/// O questionário de cargo mandado por link a quem ocupa o cargo. As respostas
/// viram a descrição. Como no teste, o link é a credencial; enquanto não é
/// enviado, as respostas parciais ficam guardadas para continuar depois.
model QuestionarioDeCargo {
  id      String @id @default(cuid())
  token   String @unique
  cargoId String
  cargo   Cargo  @relation(fields: [cargoId], references: [id], onDelete: Cascade)

  /// O nível no dia do envio: mudar o nível do cargo depois não muda o formulário.
  nivel  String
  /// Quem vai responder. Não vai para a IA.
  pessoa String
  prazo  DateTime?

  /// ENVIADO ou RESPONDIDO.
  status    String @default("ENVIADO")
  respostas Json?

  enviadoPor   String?
  enviadoEm    DateTime  @default(now())
  respondidoEm DateTime?

  @@index([cargoId])
}

/// Um treinamento do catálogo da empresa: o procedimento, a norma ou o tema
/// comportamental que se ensina. Cada vez que acontece é uma turma.
model Treinamento {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// O código do procedimento, "DP-01". Opcional.
  codigo       String?
  nome         String
  /// TECNICO, COMPORTAMENTAL, INTEGRACAO ou SEGURANCA.
  categoria    String   @default("TECNICO")
  /// Horas previstas por turma.
  cargaHoraria Decimal? @db.Decimal(6, 2)
  descricao    String?  @db.Text
  /// Fora de uso: sai das listas de escolha, mas o histórico continua.
  ativo        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A matriz: os cargos que precisam deste treinamento.
  cargos     TreinamentoDoCargo[]
  turmas     TurmaDeTreinamento[]
  /// Ações de PDI que pedem este treinamento.
  acoesDePdi DevelopmentAction[]

  @@index([companyId])
}

/// Uma marca da matriz de treinamento: este cargo precisa deste treinamento.
model TreinamentoDoCargo {
  treinamentoId String
  treinamento   Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  cargoId       String
  cargo         Cargo       @relation(fields: [cargoId], references: [id], onDelete: Cascade)

  @@id([treinamentoId, cargoId])
  @@index([cargoId])
}

/// Uma turma: o treinamento acontecendo numa data, para um grupo de pessoas.
///
/// A turma é uma reunião (Meeting) com estes dados a mais: assim tem a mesma
/// página, os mesmos convocados e presentes, a mesma agenda e a mesma ata.
/// Enquanto só tem o mês previsto, a reunião fica PLANEJADA (fora da aba
/// Reuniões e da agenda); com dia, vira AGENDADA; encerrada, REALIZADA. Quem
/// esteve presente numa turma realizada tem o treinamento no histórico.
model TurmaDeTreinamento {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  treinamentoId String
  treinamento   Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: NoAction)
  meetingId     String      @unique
  meeting       Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// O mês planejado (dia 1, UTC), enquanto a turma não tem dia marcado.
  mesPrevisto   DateTime?
  instrutor     String?
  /// INTERNO ou EXTERNO.
  modalidade    String    @default("INTERNO")
  /// Horas desta turma; vazio usa a carga horária do treinamento.
  horas         Decimal?  @db.Decimal(6, 2)
  investimento  Decimal?  @db.Decimal(12, 2)
  material      String?   @db.Text
  /// Por que não aconteceu. Preenchida, a turma conta como "justificada".
  justificativa String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([treinamentoId])
}

/// Um item do checklist de integração da empresa. É copiado para a ficha de
/// cada pessoa nova da equipe.
model ItemDoModeloDeIntegracao {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  texto     String
  ordem     Int     @default(0)

  @@index([companyId])
}

/// Um item do checklist de integração de uma pessoa, marcado quando é feito.
model EtapaDeIntegracao {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  texto      String
  ordem      Int       @default(0)
  feito      Boolean   @default(false)
  feitoEm    DateTime?

  @@index([employeeId])
}

// ------------------------------------------------------- pesquisa de clima

/// Um tema que a pesquisa de clima mede (Liderança, Comunicação...). A
/// biblioteca é uma só para o sistema; cada empresa escolhe o que usa.
model DimensaoDeClima {
  id        String  @id @default(cuid())
  nome      String
  descricao String? @db.Text
  ordem     Int     @default(0)
  ativa     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  perguntas PerguntaDeClima[]

  @@index([ordem])
}

/// Uma pergunta da biblioteca (companyId vazio) ou própria de uma empresa.
///
/// Toda pergunta de nota é escrita para que nota alta seja bom: não existe
/// pergunta invertida.
model PerguntaDeClima {
  id         String          @id @default(cuid())
  dimensaoId String
  dimensao   DimensaoDeClima @relation(fields: [dimensaoId], references: [id], onDelete: Cascade)
  /// Preenchido quando a pergunta foi criada só para uma empresa.
  companyId  String?
  company    Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  enunciado   String  @db.Text
  /// NOTA, ESCOLHA (uma opção), MULTIPLA (até maxEscolhas) ou TEXTO.
  tipo        String  @default("NOTA")
  /// As opções das perguntas de escolha: ["Sim", "Não"].
  opcoes      Json?
  maxEscolhas Int?
  /// A pergunta "recomendaria a empresa", de 0 a 10, que dá o eNPS.
  enps        Boolean @default(false)
  /// Entra sozinha na primeira pesquisa de uma empresa.
  padrao      Boolean @default(false)
  ordem       Int     @default(0)
  ativa       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usos PerguntaDaPesquisa[]

  @@index([dimensaoId])
  @@index([companyId])
}

/// Um ciclo da pesquisa de clima de uma empresa ("Clima 2026").
///
/// RASCUNHO se monta; ABERTA recebe respostas pelo link; ENCERRADA não recebe
/// mais. HISTORICO é um ciclo feito fora do sistema, de que só se digitaram as
/// médias por dimensão, para o comparativo já nascer com o passado.
model PesquisaDeClima {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  nome   String
  /// O código do link público. É a única credencial de quem responde.
  token  String @unique
  status String @default("RASCUNHO")

  abertaEm    DateTime?
  /// Último dia para responder (inclusive).
  prazo       DateTime? @db.Date
  encerradaEm DateTime?

  /// Quantas pessoas foram convidadas, para a taxa de adesão.
  convidados Int?
  /// Nota a partir da qual a resposta está dentro do esperado.
  regua      Decimal @default(6) @db.Decimal(4, 2)
  introducao String? @db.Text

  /// As perguntas de perfil: [{ chave, rotulo, opcoes: string[] }].
  perfil          Json
  /// O texto da conclusão de cada dimensão no relatório: { [dimensao]: texto }.
  conclusoes      Json?
  /// Só nos ciclos de histórico: { [dimensao]: media }.
  mediasDigitadas Json?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  perguntas PerguntaDaPesquisa[]
  respostas RespostaDeClima[]
  acoes     AcaoDeClima[]

  @@index([companyId])
}

/// A pergunta como ela foi para a pesquisa. Editar a biblioteca depois não
/// muda o que já foi perguntado, e o comparativo entre ciclos usa a pergunta
/// de origem para achar a mesma pergunta no ciclo anterior.
model PerguntaDaPesquisa {
  id         String           @id @default(cuid())
  pesquisaId String
  pesquisa   PesquisaDeClima  @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  perguntaId String?
  pergunta   PerguntaDeClima? @relation(fields: [perguntaId], references: [id], onDelete: SetNull)

  dimensao      String
  dimensaoOrdem Int     @default(0)
  enunciado     String  @db.Text
  tipo          String
  opcoes        Json?
  maxEscolhas   Int?
  enps          Boolean @default(false)
  ordem         Int     @default(0)

  itens ItemDaResposta[]

  @@index([pesquisaId])
  @@index([perguntaId])
}

/// Uma resposta anônima. Não há nome, email, IP nem hora: só o dia, e o id é
/// aleatório (um cuid carregaria o momento em que foi criado).
model RespostaDeClima {
  id           String          @id @default(uuid())
  pesquisaId   String
  pesquisa     PesquisaDeClima @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  /// O perfil escolhido: { [chave]: opcao }.
  perfil       Json
  respondidaEm DateTime        @db.Date

  itens ItemDaResposta[]

  @@index([pesquisaId])
}

model ItemDaResposta {
  id         String             @id @default(uuid())
  respostaId String
  resposta   RespostaDeClima    @relation(fields: [respostaId], references: [id], onDelete: Cascade)
  perguntaId String
  pergunta   PerguntaDaPesquisa @relation(fields: [perguntaId], references: [id], onDelete: Cascade)

  nota     Int?
  escolhas String[]
  texto    String?  @db.Text

  /// O texto como vai para o relatório, sem trechos que identifiquem alguém.
  textoRevisado String? @db.Text
  ocultar       Boolean @default(false)

  @@index([respostaId])
  @@index([perguntaId])
}

/// Uma ação do plano que sai da pesquisa, presa a uma dimensão. O ciclo
/// seguinte mostra o que foi feito e se a dimensão melhorou.
model AcaoDeClima {
  id          String          @id @default(cuid())
  pesquisaId  String
  pesquisa    PesquisaDeClima @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  dimensao    String
  descricao   String          @db.Text
  responsavel String?
  prazo       DateTime?       @db.Date
  /// PENDENTE, ANDAMENTO ou CONCLUIDA.
  status      String          @default("PENDENTE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pesquisaId])
}
