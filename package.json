{
  "name": "rh-resultados",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "producao": "npm run build && next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:servicos": "tsx prisma/seed-servicos.ts",
    "db:reset": "node --env-file=.env scripts/reset-db.mjs",
    "db:studio": "prisma studio",
    "test": "tsx --test tests/*.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^1.42.0",
    "next": "15.5.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.16.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
