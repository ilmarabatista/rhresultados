# Banco de dados PostgreSQL (Neon, Supabase ou Vercel Postgres).
# Para desenvolvimento local use "npm run db:local" e:
#   postgresql://rh:rh@127.0.0.1:5433/rhresultados
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Segredo para assinar a sessao (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-uma-chave-aleatoria-longa"

# Administrador inicial criado pelo seed
ADMIN_EMAIL="admin@empresa.com.br"
ADMIN_PASSWORD="senha-forte-aqui"
ADMIN_NAME="Administrador"

# IA opcional (OpenRouter). Só é usada quando se pede, em Roteiros ("Pedir à IA")
# e no plano técnico da Equipe ("Pedir proposta à IA"). Sem chave, tudo funciona
# à mão.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
# Teto de tokens da resposta: sem ele o OpenRouter reserva o maximo do modelo
# e recusa a chamada quando o saldo nao cobre esse pior caso.
OPENROUTER_MAX_TOKENS="8000"
# Modelo para texto com dado pessoal (a entrevista do candidato). Precisa ser
# pago: a chamada pede ao OpenRouter só provedor com retenção zero, e falha em
# vez de cair num modelo gratuito que guarda o que recebe.
OPENROUTER_MODEL_PRIVADO="anthropic/claude-haiku-4.5"
# Endereço público do sistema. Os links de teste são montados com o
# endereço de onde o sistema está aberto; este fica de reserva. No servidor
# publicado, o domínio de lá.
APP_URL="http://localhost:3000"

# Sistema de ponto (à parte, pasta ponto/). Endereço dele e a chave que os dois
# sistemas usam para conversar; a mesma INTEGRACAO_SECRET vai no ponto.
PONTO_URL="https://rhresultados-ponto.vercel.app"
INTEGRACAO_SECRET="gere-com-openssl-rand-base64-32"
